<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required to capture audio from the physical guitar audio interface -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Required under Hardened Runtime to load third-party in-process Audio Units (Line 6 Helix Native) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Required for audio plugins that utilize dynamic DSP code generation / JIT -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>

